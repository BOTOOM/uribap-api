ENVIRONMENT=development
APP_NAME=Uribap API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://uribap:uribap@localhost:5432/uribap
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
OIDC_ISSUER=http://localhost:8080
OIDC_AUDIENCE=uribap-api
OIDC_JWKS_URL=http://localhost:8080/oauth/v2/keys
OIDC_USERINFO_URL=http://localhost:8080/oidc/v1/userinfo
OIDC_USERINFO_CONNECT_HOST=
OIDC_JWKS_HOST=localhost
OIDC_ALGORITHMS=RS256
OIDC_REQUIRED_SCOPES=
OIDC_JWKS_TTL_SECONDS=300
OIDC_TIMEOUT_SECONDS=5
OIDC_CLOCK_SKEW_SECONDS=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=uribap@localhost
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=5
EMAIL_DELIVERY_ENABLED=false
WEB_BASE_URL=http://localhost:3000
